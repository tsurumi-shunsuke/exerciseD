@startuml parser
skinparam classAttributeIconSize 0
left to right direction
scale 0.9
skinparam defaultFontSize 17
skinparam classFontSize 20
skinparam nodesep 5
skinparam ranksep 5
skinparam classPadding 10
skinparam ArrowThickness 0.7

' ====== 例外 ======
class ParseError {
  int lineNo
  ParseError(int lineNo)
}

' ====== トークン ======
class TsToken {
  String kind
  String id
  int lineNo
  TsToken(String kind, String id, int lineNo)
}

' ====== 入力ソース（トークン列） ======
class TsSource {
  java.util.List<TsToken> tokens
  int index
  TsSource(java.nio.file.Path tsPath)
  TsToken peek()
  TsToken pop()
  boolean eof()
}

' ====== 構文規則（再帰下降） ======
class Syntax {
  final TsSource ts
  Syntax(TsSource ts)

  ' 代表的な公開メソッド（必要に応じて調整）
  Program parseProgram()
  Block parseBlock()
  Compound parseCompound()
  ( 省略 )

  ' 内部ヘルパ（概念名）
  void expect(String kind)
  TsToken expectRet(String kind)
  boolean accept(String kind)
}

' ====== エントリポイント ======
class Parser {
  static void main(String[] args)
  String run(String inTsPath, String outPath)
}

' ====== 関係（多重度付き） ======
Parser  "1" --> "1"  TsSource : creates/uses
Parser  "1" --> "1"  Syntax   : creates/uses
Parser  ..> "0..*" ParseError : catches

Syntax  "1" *-- "1"  TsSource : ts
Syntax  ..> "0..*" ParseError : throws
TsSource  *--  TsToken : tokens
TsSource --> "1" TsToken : returns 

@enduml
