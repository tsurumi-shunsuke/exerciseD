package enshud.s2.parser;

import enshud.ast.*;

public class Syntax {
	// 入力文の情報を保存しているオブジェクトを受け取り，tsに保存する
    private final TsSource ts;
    public Syntax(TsSource ts) { this.ts = ts; }
	
    // 構文解析を開始する関数
    // プログラム = "program" プログラム名 ";" ブロック 複合文 "."
    public void parseProgram() {
        expect("SPROGRAM");
        expect("SIDENTIFIER");
        expect("SSEMICOLON");
        parseBlock();
        parseCompound();
        expect("SDOT");
    }
    
    // ブロックを解析
    // ブロック = 変数宣言 副プログラム宣言群
    public void parseBlock() {
    	
    }
    
	// 複合文を解析
    // 複合文 = "begin" 文の並び "end"
    public void parseCompound() {
    	expect("SBEGIN");
    	
    	expect("SEND");
    }
	
    // 文を解析
    /* 文 = 基本文 |
    		"if" 式 "then" 複合文 "else" 複合文 |
    		"if" 式 "then" 複合文 |
    		"while" 式 "do" 複合文. */
    private void parseStatement() {
        if (at("SBEGIN")) {
            parseCompound();
        } else if (at("SIF")) {
            next(); parseExpr(); expect("STHEN");
            parseCompound();
            if (match("SELSE")) parseCompound();
        } else if (at("SWHILE")) {
            next(); parseExpr(); expect("SDO");
            parseCompound();
        } else if (at("SREADLN") || at("SWRITELN")) {
            parseIOStmt();
        } else if (at("SIDENTIFIER")) {
            parseAssignOrCall();
        } else {
            fail();
        }
    }
    
    
    
    
    
    
    // 引数と，参照入力文におけるトークンの一致の真偽を返す （matchで呼び出す）
    private boolean at(String kind) {
        return ts.peek().kind.equals(kind);
    }
    
    // トークンが一致している場合，参照する文を更新　（expectで呼び出す）
    private boolean match(String kind) {
        if (at(kind)) { ts.advance(); return true; }
        return false;
    }
    
    // トークンが一致している場合，参照する文を更新
    // トークンが一致しない場合，エラーとして構文解析を終了
    private void expect(String kind) {
        if (!match(kind)) throw new ParseError(ts.peek().lineNo);
    }
}
