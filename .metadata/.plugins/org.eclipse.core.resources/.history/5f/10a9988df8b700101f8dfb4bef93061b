package enshud.s2.parser;

public class Syntax {
    private final TsSource ts;
    public Syntax(TsSource ts) { this.ts = ts; }

    // プログラム:= "program" プログラム名 ";" ブロック 複合文 "."
    public void parseProgram() {
        expect("SPROGRAM");
        expect("SIDENTIFIER");
        expect("SSEMICOLON");
        parseBlock();
        parseCompound();
        expect("SDOT");
    }

    // ブロック:= 変数宣言 副プログラム宣言群
    public void parseBlock() {
        parseVarDeclPart();   // [ "var" 変数宣言の並び ]
        parseProcDecls();     // { 副プログラム宣言 ";" }
    }

    // 複合文:= "begin" 文の並び "end"
    // 文の並び:= 文 ";" { 文 ";" }
    public void parseCompound() {
        expect("SBEGIN");
        parseStatement();
        expect("SSEMICOLON");
        while (!at("SEND")) {
            parseStatement();
            expect("SSEMICOLON");
        }
        expect("SEND");
    }

    // 文:= 基本文 | if ... | while ...
    private void parseStatement() {
        if (at("SBEGIN")) {
            parseCompound();
        } else if (at("SIF")) {
            next();
            parseExpr();
            expect("STHEN");
            parseCompound();
            if (match("SELSE")) {
            	parseCompound();
            }
        } else if (at("SWHILE")) {
            next();
            parseExpr();
            expect("SDO");
            parseCompound();
        } else if (at("SREADLN") || at("SWRITELN")) {
            parseIOStmt();
        } else if (at("SIDENTIFIER")) {
            parseAssignOrCall();
        } else {
            fail();
        }
    }

    // 基本文:= 代入文 | 手続き呼出し文 | 入出力文 | 複合文.
    // 代入文:= 左辺 ":=" 式.
    // 手続き呼出し文:= 手続き名 [ "(" 式の並び ")" ].
    private void parseAssignOrCall() {
        expect("SIDENTIFIER");

        // 手続き呼出し: name "(" [式 {, 式}] ")"
        if (match("SLPAREN")) {
            if (!at("SRPAREN")) {
                parseExpr();
                while (match("SCOMMA")) {
                	parseExpr();
                }
            }
            expect("SRPAREN");
            return;                            // 呼出し確定
        }

        // 左辺が配列要素なら添字を読む： name "[" 式 "]"
        if (match("SLBRACKET")) {
            parseExpr();
            expect("SRBRACKET");
            expect("SASSIGN");
            parseExpr();
            return;                            // 代入確定
        }

        // 純変数代入： name ":=" 式
        if (match("SASSIGN")) {
            parseExpr();
            return;                            // 代入確定
        }

        // ここまで来たら引数なし手続き呼出し "name"
        // 直後の ';' は複合文側（parseCompound）で強制される
        return;
    }

    // 入出力文:= "readln" [ "(" 変数の並び ")" ] | "writeln" [ "(" 式の並び ")" ]
    private void parseIOStmt() {
        if (match("SREADLN")) {
            if (match("SLPAREN")) {
                parseLValue();
                while (match("SCOMMA")) {
                	parseLValue();
                }
                expect("SRPAREN");
            }
        } else {
            expect("SWRITELN");
            if (match("SLPAREN")) {
                parseExpr();
                while (match("SCOMMA")) {
                	parseExpr();
                }
                expect("SRPAREN");
            }
        }
    }

    // 左辺:= 変数 = 純変数 | 添字付き変数
    private void parseLValue() {
        expect("SIDENTIFIER");
        if (match("SLBRACKET")) { 
        	parseExpr(); 
        	expect("SRBRACKET"); 
        }
    }

    // 変数宣言:= [ "var" 変数宣言の並び ]
    // 変数宣言の並び:= 変数名の並び ":" 型 ";" { 変数名の並び ":" 型 ";" }
    private void parseVarDeclPart() {
        if (match("SVAR")) {
            parseVarDeclLine(); 
            expect("SSEMICOLON");
            while (at("SIDENTIFIER")) {
                parseVarDeclLine(); 
                expect("SSEMICOLON");
            }
        }
    }

    // 変数名の並び ":" 型
    private void parseVarDeclLine() {          
        parseIdentList();
        expect("SCOLON");
        parseType();
    }

    // 変数名の並び
    private void parseIdentList() {
        expect("SIDENTIFIER");
        while (match("SCOMMA")) {
        	expect("SIDENTIFIER");
        }
    }

    // 型:= 標準型 | 配列型
    // 標準型:= "integer" | "char" | "boolean"
    // 配列型:= "array" "[" 整数 ".." 整数 "]" "of" 標準型
    private void parseType() {
    	// 標準型
        if (match("SINTEGER") || match("SCHAR") || match("SBOOLEAN")) return;
        // 配列型
        if (match("SARRAY")) {
            expect("SLBRACKET");
            parseInteger();           // 添字の最小値
            expect("SRANGE");         // ".."
            parseInteger();           // 添字の最大値
            expect("SRBRACKET");
            expect("SOF");
            if (!(match("SINTEGER") || match("SCHAR") || match("SBOOLEAN"))) fail();
            return;
        }
        fail();
    }

    // 整数:= [ 符号 ] 符号なし整数
    // 符号:= "+" | "-" ; 符号なし整数 = SCONSTANT
    private void parseInteger() {
        match("SPLUS"); 
        match("SMINUS");
        expect("SCONSTANT");
    }

    // 副プログラム宣言群:= { 副プログラム宣言 ";" }
    // 副プログラム宣言:= 副プログラム頭部 変数宣言 複合文
    // 副プログラム頭部:= "procedure" 手続き名 仮パラメータ ";"
    private void parseProcDecls() {
        while (match("SPROCEDURE")) {
            expect("SIDENTIFIER");   // 手続き名
            parseParamsOpt();        // 仮パラメータ
            expect("SSEMICOLON");
            parseVarDeclPart();      // 手続き内 var
            parseCompound();         // 本体
            expect("SSEMICOLON");    // 宣言の区切り
        }
    }

    // 仮パラメータ:= [ "(" 仮パラメータの並び ")" ]
    // 仮パラメータの並び:= 仮パラメータ名の並び ":" 標準型 { ";" 仮パラメータ名の並び ":" 標準型 }
    private void parseParamsOpt() {
        if (match("SLPAREN")) {
            if (!at("SRPAREN")) {
                parseParamGroup();
                while (match("SSEMICOLON")) {
                	parseParamGroup();
                }
            }
            expect("SRPAREN");
        }
    }

    // 仮パラメータ名の並び ":" 標準型
    private void parseParamGroup() {   
        parseIdentList();
        expect("SCOLON");
        // 標準型
        if (!(match("SINTEGER") || match("SCHAR") || match("SBOOLEAN"))) fail();
    }

    // 式:= 単純式 [ 関係演算子 単純式 ]
    // 関係演算子:= "=" | "<>" | "<" | "<=" | ">" | ">="
    private void parseExpr() {
        parseSimpleExpr();
        if (at("SEQUAL") || at("SNOTEQUAL") || at("SLESS") || at("SLESSEQUAL") || at("SGREAT") || at("SGREATEQUAL")) {
            next();
            parseSimpleExpr();
        }
    }

    // 単純式:= [ 符号 ] 項 { 加法演算子 項 }
    // 加法演算子:= "+" | "-" | "or"
    private void parseSimpleExpr() {
        match("SPLUS"); 
        match("SMINUS");  // 先頭符号
        parseTerm();
        while (at("SPLUS") || at("SMINUS") || at("SOR")) {
            next(); 
            parseTerm();
        }
    }

    // 項 = 因子 { 乗法演算子 因子 }.
    // 乗法演算子 = "*" | "/" | "div" | "mod" | "and".
    //  ※ "/" と "div" はどちらも SDIVD で来る
    private void parseTerm() {
        parseFactor();
        while (at("SSTAR") || at("SDIVD") || at("SMOD") || at("SAND")) {
            next(); parseFactor();
        }
    }

    // 因子 = 変数 | 定数 | "(" 式 ")" | "not" 因子.
    private void parseFactor() {
        if (match("SIDENTIFIER")) {
            if (match("SLBRACKET")) { parseExpr(); expect("SRBRACKET"); } // 配列参照
            return;
        }
        if (match("SCONSTANT") || match("SSTRING") || match("STRUE") || match("SFALSE")) return;
        if (match("SLPAREN")) { parseExpr(); expect("SRPAREN"); return; }
        if (match("SNOT")) { parseFactor(); return; }
        fail();
    }

    // ──────────────────────────────
    // Helpers
    // ──────────────────────────────
    private boolean at(String kind) {
        return ts.peek().kind.equals(kind);
    }
    private boolean match(String kind) {
        if (at(kind)) { ts.advance(); return true; }
        return false;
    }
    private void expect(String kind) {
        if (!match(kind)) fail();
    }
    private void next() {
        ts.advance();
    }
    private void fail() {
        throw new ParseError(ts.peek().lineNo);
    }
}
