package enshud.ast;

/** program 名 ; block compound . */
public record Program(String name, Block block, Compound main, int line) implements Node {

	@Override
	public <R> R accept(AstVisitor<R> v) {
		// 意味解析器Semantic（Type型）から呼び出され，Semanticのvisitを呼び出す．双方向の関係性．
		return (R) v.visitProgram(this);
	}
}
