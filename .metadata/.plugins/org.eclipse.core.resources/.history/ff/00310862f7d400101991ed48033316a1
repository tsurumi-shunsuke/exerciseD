package enshud.ast;

import java.util.List;

/** procedure p(params); 変数宣言 複合文 ; */
public record ProcedureDecl(
    String                 name,
    java.util.List<Param>  params, // 仮パラメータ。なければ空リスト
    java.util.List<VarDecl>locals, // 手続き内の var 宣言（なければ空）
    Compound               body,    // 複合文
    int                    line
) implements Node {}
