package enshud.s1.lexer;

public class Tokenizer {
    private final String text;
    private final int len;
    private int line = 1;
    private int tokenLine = 1;
    private int index = 0;
    private char currentChar;
    private char nextChar;

    public Tokenizer(String text) {
        this.text = text;
        this.len = text.length();
        lookahead();
    }

    // 行番号を取得
    public int tokenLine() { return tokenLine; }

    // EOF検出
    private boolean eof() { return index >= len; }

    // 参照文字を更新
    private void lookahead() {
        currentChar = (index < len) ? text.charAt(index) : (char) 0;
        nextChar = (index + 1 < len) ? text.charAt(index + 1) : (char) 0;
    }

    // インデックスを更新
    private void advance() {
        if (eof()) return;
        char consumed = text.charAt(index++);
        if (consumed == '\n') line++;
        lookahead();
    }

    // 空白とコメントアウトを消去
    private void skip() {
        while (!eof()) {
            // 空白を消去
            if (Character.isWhitespace(currentChar)) {
                advance();
                continue;
            }
            // コメント { ... }
            if (currentChar == '{') {
                advance();
                while (!eof() && currentChar != '}') {
                    advance();
                }
                if (!eof()) advance();
                continue;
            }
            // コメント (* ... *)
            if (currentChar == '(' && nextChar == '*') {
                advance(); // (
                advance(); // *
                while (!eof() && !(currentChar == '*' && nextChar == ')')) {
                    advance();
                }
                if (!eof()) { advance(); advance(); } // *) を飛ばす
                continue;
            }
            // 行コメント // ...
            if (currentChar == '/' && nextChar == '/') {
                while (!eof() && currentChar != '\n') advance();
                continue;
            }
            break;
        }
    }

    // 次のトークンを返す．無ければ null
    public Token nextToken() {
        skip();
        if (eof()) return null;

        tokenLine = line;

        if (isSymbol(currentChar)) {
            // 先頭が記号
            return readSymbol();
        } else if (isNumber(currentChar)) {
            // 先頭が数字
            return readNumber();
        } else if (currentChar == '\'') {
            return readQuoted();
        } else {
            // 先頭が英数字（識別子と文字列の判定は Token 側）
            return readWord();
        }
    }

    // 先頭文字が記号かどうか判定
    private boolean isSymbol(char ch) {
        return (ch == '=' ||
                ch == '<' ||
                ch == '>' ||
                ch == '+' ||
                ch == '-' ||
                ch == '*' ||
                ch == '/' ||
                ch == '(' ||
                ch == ')' ||
                ch == '[' ||
                ch == ']' ||
                ch == ';' ||
                ch == ':' ||
                ch == ',' ||
                ch == '.');
    }

    // 先頭文字が数字かどうか判定
    private boolean isNumber(char ch) { return ch >= '0' && ch <= '9'; }

    // 先頭文字が英数字かどうか判定（_ を含む）
    private boolean isWord(char ch) { return Character.isLetterOrDigit(ch) || ch == '_'; }

    // 記号を読み進める（最長一致）
    private Token readSymbol() {
        if ((currentChar == '<' && (nextChar == '>' || nextChar == '=')) ||
            (currentChar == '>' && nextChar == '=') ||
            (currentChar == ':' && nextChar == '=') ||
            (currentChar == '.' && nextChar == '.')) {
            String two = "" + currentChar + nextChar;
            advance();
            advance();
            return new Token(two);
        } else {
            char one = currentChar;
            advance();
            return new Token(String.valueOf(one));
        }
    }

    // 数字を読み進める
    private Token readNumber() {
        StringBuilder sb = new StringBuilder();
        while (!eof() && isNumber(currentChar)) {
            sb.append(currentChar);
            advance();
        }
        return new Token(sb.toString());
    }

    // 文字列を読み進める（'' で囲まれた文字列）
    private Token readQuoted() {
        StringBuilder sb = new StringBuilder();
        sb.append(currentChar); // 先頭 '
        advance();
        while (!eof()) {
            char ch = currentChar;
            sb.append(ch);
            advance();
            // 2つ目の ' で終了（'' は内部の一重引用符）
            if (ch == '\'') {
                if (currentChar == '\'') {
                    sb.append(currentChar);
                    advance();
                    continue;
                }
                break;
            }
            if (ch == '\n') break;
        }
        return new Token(sb.toString());
    }

    // 英数字を読み進める
    private Token readWord() {
        StringBuilder sb = new StringBuilder();
        while (!eof() && isWord(currentChar)) {
            sb.append(currentChar);
            advance();
        }
        return new Token(sb.toString());
    }
}
