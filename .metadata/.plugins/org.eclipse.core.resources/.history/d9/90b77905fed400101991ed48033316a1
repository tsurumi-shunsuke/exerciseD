public class Type {

    // 基本型（integer / char / boolean）
    public final BasicType base;

    // 配列かどうか
    public final boolean isArray;

    // 配列なら添字の範囲（[lower..upper]）
    public final int lower;
    public final int upper;

    // コンストラクタは外から直接呼ばせない（静的メソッド経由）
    private Type(BasicType base, boolean isArray, int lower, int upper) {
        this.base = base;
        this.isArray = isArray;
        this.lower = lower;
        this.upper = upper;
    }

    // ---------- 標準型用のファクトリ ----------

    public static Type integer() {
        return new Type(BasicType.INTEGER, false, 0, 0);
    }

    public static Type charType() {
        return new Type(BasicType.CHAR, false, 0, 0);
    }

    public static Type booleanType() {
        return new Type(BasicType.BOOLEAN, false, 0, 0);
    }

    // ---------- 配列型用のファクトリ ----------

    public static Type arrayOf(BasicType base, int lower, int upper) {
        return new Type(base, true, lower, upper);
    }

    // ---------- よく使う判定 ----------

    public boolean isInteger() {
        return !isArray && base == BasicType.INTEGER;
    }

    public boolean isChar() {
        return !isArray && base == BasicType.CHAR;
    }

    public boolean isBoolean() {
        return !isArray && base == BasicType.BOOLEAN;
    }
}