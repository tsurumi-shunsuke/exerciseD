package enshud.s2.parser;

public class TsSource {
	// 入力文各行の情報を保存していくリスト
	private final java.util.List<TsToken> tokens = new java.util.ArrayList<>();
	// リストの最新番号
	private int p = 0;
	
	// TsSource生成時に入力文を分解し，tokensに格納
	public TsSource(java.io.File tsFile) throws java.io.IOException {
		try (var br = new java.io.BufferedReader(
				new java.io.InputStreamReader(
						new java.io.FileInputStream(tsFile), java.nio.charset.StandardCharsets.UTF_8))) {
			String line;
			int lastLineNo = 1;
			
			// 各行を名前・種類・ID・行番号に分解
			while((line = br.readLine()) != null) {
				line = line.trim();
				if (line.isEmpty()) continue;
				
				// 文字列中の空白に対応するために，後ろの空白から処理
				int sp3 = lastWs(line);
				int lineNo = Integer.parseInt(line.substring(sp3 + 1));
				line = line.substring(0, sp3);
				
				int sp2 = lastWs(line);
				int id = Integer.parseInt(line.substring(sp2 + 1));
				line = line.substring(0, sp2);	
								
				int sp1 = lastWs(line);
				String kind = line.substring(sp1 + 1);
				
				String name = line.substring(0, sp1);
				
				lastLineNo = lineNo;
				// 入力文のname, kind, id, lastLineNoを保存したTsTokenオブジェクトを格納
				tokens.add(new TsToken(name, kind, id, lastLineNo));
			}

			if (tokens.isEmpty() || !"SEOF".equals(tokens.get(tokens.size()-1).kind)) {
			    tokens.add(new TsToken("", "SEOF", -1, lastLineNo));
			}
		}
	}
	
	// 文の後ろから空白の位置を探し，それを返す
    private static int lastWs(String s) {
        for (int i = s.length() - 1; i >= 0; i--) {
            if (Character.isWhitespace(s.charAt(i))) return i;
        }
        return -1;
    }
	
    // 最新の文の情報を保存したTsTokenオブジェクトを返す
	TsToken peek() { return tokens.get(p); }
	
	// 参照する文を更新
	void advance() { if (p < tokens.size() - 1) p++; }
	
	// ファイルの終了を検知
	boolean eof() { return "SEOF".equals(peek().kind); }
}
