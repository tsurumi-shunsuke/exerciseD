package enshud.s3.checker;
import enshud.ast.*;


public class Semantic implements AstVisitor<Type>{
	private final SymbolTable symtab = new SymbolTable();
	
	public Semantic(Program prog) {
		symtab.enterScope();
		// ASTに意味解析器Semanticを渡し，visitを返してもらう（program以下の意味解析）
		prog.accept(this);
		symtab.exitScope();
	}

	@Override
	public Type visitProgram(Program node) {
		if (node.block() != null) {
			// blockの意味解析
			node.block().accept(this);
		}
		if (node.main() != null) {
			// compoundの意味解析
			node.main().accept(this);
		}
		return null;
	}

	@Override
	public Type visitBlock(Block node) {
		if (node.vars() != null) {
			for (VarDecl v : node.vars()) {
				// varDeclの意味解析
				v.accept(this);
			}
		}
		if (node.procs() != null) {
			for (ProcedureDecl p : node.procs()) {
				// procedureDeclの意味解析
				p.accept(this);
			}
		}
		return null;
	}

	@Override
	public Type visitCompound(Compound node) {
		return null;
	}

	@Override
	public Type visitVarDecl(VarDecl node) {
		Type t = resolveType(node.type(), node.line());
		for (String name : node.names()) {
			Symbol sym = new Symbol();
			sym.name = name;
			sym.kind = SymbolKind.VAR;
			sym.type = t;
			sym.line = node.line();
			// 変数名の重複チェック
			symtab.declare(sym);
		}
		return null;
	}

	@Override
	public Type visitProcedureDecl(ProcedureDecl node) {
		Symbol procSym = new Symbol();
		procSym.name = node.name();
		procSym.kind = SymbolKind.PROC;
		procSym.type = null;  // 手続きは型なし
		procSym.line = node.line();
		procSym.paramTypes = new java.util.ArrayList<Type>();
		// 手続き名の重複チェック
		symtab.declare(procSym);
		
		// 手続き用のスコープを展開
		symtab.enterScope();
		// paramの意味解析
		for (Param p : node.params()) {
			Type t = resolveType(p.type(), p.line());
			procSym.paramTypes.add(t);
			for (String name : p.names()) {
				Symbol paramSym = new Symbol();
				paramSym.name = name;
				paramSym.kind = SymbolKind.PARAM;
				paramSym.type = t;
				paramSym.line = p.line();
				symtab.declare(paramSym);	
			}
		}
		for (VarDecl v : node.locals()) {
			// varDeclの意味解析
			v.accept(this);  // visitVarDecl()が返される
		}
		if (node.body() != null) {
			// compoundの意味解析
			node.body().accept(this);
		}
		symtab.exitScope();
		return null;
	}

	
	
	// TypeNode → Typeに変換
	private Type resolveType(TypeNode tnode, int declLine) {
	    if (tnode instanceof BuiltinType bt) {
	        return switch (bt) {
	            case INTEGER -> Type.integer();
	            case CHAR    -> Type.charType();
	            case BOOLEAN -> Type.booleanType();
	            default -> throw new CheckError(declLine);
	        };

	    } else if (tnode instanceof ArrayType at) {
	        // 添字範囲のチェック
	        long lower = at.lower();
	        long upper = at.upper();
	        if (lower > upper) {
	            throw new CheckError(at.line());
	        }
	        
	        BuiltinType elem = at.elem();
	        BasicType base = switch (elem) {
	            case INTEGER -> BasicType.INTEGER;
	            case CHAR    -> BasicType.CHAR;
	            case BOOLEAN -> BasicType.BOOLEAN;
	            default -> throw new CheckError(declLine);
	        };

	        return Type.arrayOf(base, lower, upper);
	    }
		return null;
	}

	
}
