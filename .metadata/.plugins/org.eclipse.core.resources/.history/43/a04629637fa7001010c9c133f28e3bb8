package enshud.s1.lexer;

public class Debag { // クラス名はファイル名と合わせて（Debag.java）
    public static void main(String[] args) {
        Token t1 = new Token("and");
        System.out.println(t1.name + "\t" + t1.type + "\t" + t1.id); // 期待: and  SAND  0

        // 追加の簡易テスト
        Token t2 = new Token("program");
        System.out.println(t2.name + "\t" + t2.type + "\t" + t2.id); // 期待: program  SPROGRAM  17

        Token t3 = new Token(":=");
        System.out.println(t3.name + "\t" + t3.type + "\t" + t3.id); // 期待: :=  SASSIGN  40

        Token t4 = new Token("123");
        System.out.println(t4.name + "\t" + t4.type + "\t" + t4.id); // 期待: 123  SCONSTANT  44

        Token t5 = new Token("'it''s'");
        System.out.println(t5.name + "\t" + t5.type + "\t" + t5.id); // 期待: 'it''s'  SSTRING  45

        Token t6 = new Token("testBasic");
        System.out.println(t6.name + "\t" + t6.type + "\t" + t6.id); // 期待: testBasic  SIDENTIFIER  43
    }
}
